# FRAUDSCOPE AI — Backend Environment Configuration

# PostgreSQL Database Connection URL
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Default fallback if unset: sqlite:///./fraudscope.db (for seamless zero-config local testing)
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/fraudscope_db

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
